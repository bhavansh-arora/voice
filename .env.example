# HTTP health-check + admin API server.
PORT=3000
# Binds to localhost only by default - put a reverse proxy (nginx/caddy)
# in front for TLS and a real domain (see deploy/nginx.conf.template and
# README). Only widen this if you specifically need the Node process
# reachable without a proxy in front of it.
# HOST=127.0.0.1

# TCP port Asterisk's AudioSocket() dialplan application connects to.
# No cloud telephony account/API key of any kind - point Asterisk at
# whatever SIP trunk provider you like; it's swappable without touching
# this app at all. See README for the Asterisk-side setup.
AUDIOSOCKET_PORT=8090
# AudioSocket's protocol has no authentication, so this only binds to
# localhost by default. Only change this if Asterisk runs on a different
# machine, and firewall this port to Asterisk's IP specifically if you do.
AUDIOSOCKET_HOST=127.0.0.1

# OpenAI (https://platform.openai.com) - powers the conversation itself
# (both the caller-facing agent and the setup chatbot).
OPENAI_API_KEY=
# Defaults to gpt-4o-mini (fast/cheap, good for a live voice call). Swap to
# another OpenAI chat model if you want more quality at the cost of latency.
OPENAI_MODEL=gpt-4o-mini

# Local, self-hosted speech microservice (tts-service/) - handles both
# speech-to-text (Whisper) and text-to-speech (Piper/MeloTTS). No cloud
# speech API of any kind. Run `uvicorn server:app` in tts-service/ and
# point this at it.
LOCAL_SPEECH_SERVICE_URL=http://127.0.0.1:8001

# Voice-activity detection tuning (src/utils/vad.ts) - telephone line/mic
# noise floors vary, so these will likely need adjusting for your setup.
# VAD_ENERGY_THRESHOLD=500
# VAD_SILENCE_HANGOVER_MS=700

# The admin password - this is what you type into /login.html to sign in.
# A successful login sets a session cookie that covers the whole admin
# surface from there: every admin page, the /dashboard WebSocket, the
# setup chatbot, voice previews, call logs/recordings, and telephony
# config. Leave unset for local-only dev (login accepts any password).
# REQUIRED if this server is reachable from anywhere beyond localhost -
# without it, anyone who finds the port can run full conversations
# through your OpenAI key for free, and read every call's transcript
# and recording.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# Where the SQLite database and call recordings are stored.
# DATA_DIR=./data
